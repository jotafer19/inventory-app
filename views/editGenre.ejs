<div class="container content form-container">
    <%- include("partials/error") %>
    <form class="form edit-form" action="/genres/<%= genre.id %>/edit?_method=PUT" method="post" enctype="multipart/form-data">
        <div class="item">
            <label for="genreName">Genre name</label>
            <input type="text" name="genreName" id="genreName" value="<%= genre.name %>" required>
        </div>
        <div class="item">
            <label for="genreImage">Genre image</label>
            <input type="file" name="genreImage" id="genreImage" accept="image/*">
        </div>

        <input type="hidden" name="_method" value="PUT" />
        
        <button class="btn submit" type="submit">Edit genre</button>
    </form>
</div>