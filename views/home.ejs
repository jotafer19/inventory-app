<div class="home-intro">
    <img class="home-img" src="/images/home_background.webp" alt="">
</div>
<div class="container games-container">
    <h2>Featured Games</h2>
    <div class="list games-list">
        <% games.forEach(game => { %>
            <a href="/games/<%= game.id %>">
                <div class="card card-container game-card">
                    <img class="card-img" src="uploads/games/<%= game.url %>" alt="<%= game.title %> image">
                    <div class="card-title"><%= game.title %></div>
                </div>
            </a>
        <% }) %>
    </div>
</div>
<div class="container genres-container">
    <h2>Featured Genres</h2>
    <div class="list genres-list">
        <% genres.forEach(genre => { %>
            <a href="/genres/<%= genre.id %>">
                <div class="card card-container genre-card">
                    <img class="card-img" src="/uploads/genres/<%= genre.logo %>" alt="<%= genre.name %> logo">
                    <div class="card-title"><%= genre.name %></div>
                </div>
            </a>
        <% }) %>
    </div>
</div>
<div class="container developers-container">
    <h2>Featured Developers</h2>
    <div class="list developers-list">
        <% developers.forEach(developer => { %>
            <a href="/developers/<%= developer.id %>">
                <div class="card card-container developer-card">
                    <img class="card-img" src="/uploads/developers/<%= developer.logo %>" alt="<%= developer.name %> logo">
                </div>
            </a>
        <% }) %>
    </div>
</div>
