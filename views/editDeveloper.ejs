<div class="container content form-container">
    <%- include("partials/error") %>
    <form class="form edit-form" action="/developers/<%= developer.id %>/edit?_method=PUT" method="post" enctype="multipart/form-data">
        <div class="item">
            <label for="developerName">Developer name</label>
            <input type="text" name="developerName" id="developerName" value="<%= developer.name %>" required>
        </div>
        <div class="item">
            <label for="developerImage">Developer image</label>
            <input type="file" name="developerImage" id="developerImage" accept="image/*">
        </div>

        <input type="hidden" name="_method" value="PUT" />
        
        <button class="btn" type="submit">Edit developer</button>
    </form>
</div>